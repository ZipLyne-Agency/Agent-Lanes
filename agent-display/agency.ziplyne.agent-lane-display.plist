<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>agency.ziplyne.agent-lane-display</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/agent-lane-display</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart after a crash or a WindowServer termination; a clean exit
       (second copy, stop signal, API missing) stays stopped. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.cache/agent-lanes-display.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.cache/agent-lanes-display.log</string>
</dict>
</plist>
