{
  "manifest_version": 3,
  "name": "Agent Lanes for Chrome",
  "version": "0.5.4",
  "version_name": "0.5.4 (Playwright extension 0.3.0 fork)",
  "description": "Lets many AI agents drive your logged-in Chrome in the background: shared normal-type, normal-state, non-focused lane windows, parked on an invisible agent display, host many input-capable agent tabs scheduled one at a time.",
  "permissions": [
    "debugger",
    "activeTab",
    "nativeMessaging",
    "storage",
    "tabs",
    "tabGroups",
    "system.display"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "lib/background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Playwright Extension - Local Canary",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": ""
}
