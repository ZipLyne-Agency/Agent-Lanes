#!/usr/bin/env bash
# Dock entrypoint for the regular authenticated Chrome profile. The helper owns
# the launch invariant and verifies that the real main process received it.
set -u

helper="$HOME/.local/bin/chrome-background-safe"
if [ ! -x "$helper" ]; then
  /usr/bin/osascript -e 'display alert "Google Chrome launcher is not installed" message "Run scripts/install.sh from agent-lanes, then try again." as critical' >/dev/null 2>&1 || true
  exit 1
fi

if ! "$helper" --check && ! "$helper" --launch; then
  /usr/bin/osascript -e 'display alert "Google Chrome did not start in background-safe mode" message "Fully quit Chrome with Command-Q, then click this Dock icon again." as critical' >/dev/null 2>&1 || true
  exit 1
fi

# Dock integration is opt-in (scripts/install.sh --dock writes the marker).
# While regular Chrome is running, pin its real bundle in the launcher's Dock
# position so macOS merges the running application into one icon. When Chrome
# exits, restore this safe launcher so the next click supplies the occlusion
# switch again. The LSUIElement wrapper remains invisible while it watches.
dock_helper="$HOME/.local/bin/install-chrome-background-safe"
dock_marker="$HOME/.config/agent-lanes/dock"
manage_dock=0
if [ -f "$dock_marker" ] && [ -x "$dock_helper" ]; then
  manage_dock=1
fi
sync_dock() {
  [ "$manage_dock" = 1 ] || return 0
  "$dock_helper" --dock-mode "$1" >/dev/null 2>&1
}
restore_launcher() {
  sync_dock launcher || true
}
trap restore_launcher EXIT
trap 'exit 0' HUP INT TERM
if ! sync_dock running; then
  exit 1
fi
# Refill the lane pool whenever it runs short, not just once per launch: lanes
# are lost to user reclaims and extension reloads, and agents may not bring
# Chrome forward to refill them. With the invisible agent display running, the
# bridge's --background mode creates lanes there while another app is in front
# and disables itself for good if Chrome ever comes forward doing so. Without
# the display, the extension creates lanes only while Chrome is already
# frontmost and refuses without creating a window otherwise, so that refusal is
# retried every second. Any other failure backs off, so a lane that keeps
# failing to provision cannot flicker a window once a second.
native_bridge="$HOME/.local/bin/playwright-mcp-native-bridge"
prepare_retry_at=0
prepare_backoff=5
pool_is_short() {
  local status parked
  status="$("$native_bridge" --status 2>/dev/null)" || return 1
  parked="$(printf '%s' "$status" | /usr/bin/sed -n 's/.*"parkedWorkspaceCount":\([0-9][0-9]*\).*/\1/p')"
  [ -n "$parked" ] && [ "$parked" -lt 4 ]
}
prepare_pool_if_possible() {
  local error
  [ -x "$native_bridge" ] || return 0
  [ "$SECONDS" -ge "$prepare_retry_at" ] || return 0
  pool_is_short || return 0
  if error="$("$native_bridge" --prepare-pool 4 --background 2>&1 >/dev/null)"; then
    prepare_backoff=5
    return 0
  fi
  case "$error" in
    *"must be foreground"*) ;;
    *)
      prepare_retry_at=$((SECONDS + prepare_backoff))
      if [ "$prepare_backoff" -lt 300 ]; then
        prepare_backoff=$((prepare_backoff * 2))
      fi
      ;;
  esac
}
prepare_pool_if_possible
while "$helper" --check; do
  prepare_pool_if_possible
  sync_dock running || exit 1
  sleep 1
done
